<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="8dp">

        <!-- Lights Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="24dp">

            <ImageView
                android:id="@+id/homeLightsIcon"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:src="@drawable/ic_kitchen_light"
                android:contentDescription="Home Lights" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginStart="16dp">

                <TextView
                    android:id="@+id/homeLightsText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Home Lights"
                    android:textSize="16sp"
                    android:textStyle="bold" />
                <Button
                    android:id="@+id/homeLightsOnButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Turn On" />

                <Button
                    android:id="@+id/homeLightsOffButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Turn Off" />
            </LinearLayout>
        </LinearLayout>

        <!-- Shutters Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="24dp">

            <ImageView
                android:id="@+id/homeShuttersIcon"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:src="@drawable/ic_shutter"
                android:contentDescription="Home Shutters" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginStart="16dp">

                <TextView
                    android:id="@+id/homeShuttersText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Home Shutters"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/homeShuttersOpenButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Open" />

                <Button
                    android:id="@+id/homeShuttersCloseButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Close"
                    android:layout_marginTop="8dp" />

                <Button
                    android:id="@+id/homeShuttersStopButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Stop"
                    android:layout_marginTop="8dp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
