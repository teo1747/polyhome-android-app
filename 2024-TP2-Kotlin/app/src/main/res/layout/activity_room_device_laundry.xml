<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:backgroundTint="@color/blue1">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/laundry"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Title for the Room -->
        <TextView
            android:id="@+id/roomTitle"
            android:layout_width="393dp"
            android:layout_height="wrap_content"
            android:paddingBottom="16dp"
            android:text="Laundry Room Devices"
            android:textAlignment="textStart"
            android:textColor="@color/white"
            android:textSize="34sp"
            android:textStyle="bold" />

        <!-- Device Container -->
        <GridLayout
            android:id="@+id/deviceContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:alignmentMode="alignMargins"
            android:background="@drawable/device_container_background"
            android:columnCount="2"
            android:padding="8dp"
            android:rowCount="2">

            <!-- Device 1: Laundry Light -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="8dp"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/laundryLightIcon"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:contentDescription="Laundry Light"
                    android:src="@drawable/ic_kitchen_light" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Laundry Light"
                    android:textColor="@color/white"
                    android:textSize="20sp" />

                <Button
                    android:id="@+id/laundryLightSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:backgroundTint="@color/blue1"
                    android:text="On" />

                <Button
                    android:id="@+id/laundryLightSwitch1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:backgroundTint="@color/blue1"
                    android:text="Off" />
            </LinearLayout>

            <!-- Device 2: Shutter -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="8dp"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/laundryShutterIcon"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:contentDescription="Laundry Shutter"
                    android:src="@drawable/ic_shutter_open" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Laundry Shutter"
                    android:textColor="@color/white"
                    android:textSize="20sp" />

                <Button
                    android:id="@+id/laundryShutterButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:backgroundTint="@color/blue1"
                    android:text="Open" />

                <Button
                    android:id="@+id/laundryShutterButton1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:backgroundTint="@color/blue1"
                    android:text="Close" />

                <Button
                    android:id="@+id/laundryShutterButton2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:backgroundTint="@color/blue1"
                    android:text="Stop" />
            </LinearLayout>

        </GridLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
