<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="8dp">

        <!-- First Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:gravity="center
"
            android:orientation="horizontal">

            <!-- Garage -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="8dp"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/iconGarage"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:contentDescription="Garage"
                    android:src="@drawable/ic_garage" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="Garage"
                    android:textSize="20sp" />
            </LinearLayout>

            <!-- Entry -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="8dp"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/iconEntry"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:contentDescription="Entry"
                    android:src="@drawable/ic_entry" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="Entry"
                    android:textSize="20sp" />
            </LinearLayout>

            <!-- Living Room -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="8dp"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/iconLivingRoom"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:contentDescription="Living Room"
                    android:src="@drawable/design_sans_titre__1_" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="Living Room"
                    android:textSize="20sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Second Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:gravity="center"
            android:orientation="horizontal">

            <!-- Kitchen -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="8dp"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/iconKitchen"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:contentDescription="Kitchen"
                    android:src="@drawable/design_sans_titre__5_" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="Kitchen"
                    android:textSize="20sp" />
            </LinearLayout>

            <!-- Dining Room -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="8dp"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/iconDiningRoom"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:contentDescription="Dining Room"
                    android:src="@drawable/ic_dining" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="Dining Room"
                    android:textSize="20sp" />
            </LinearLayout>

            <!-- Laundry -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="8dp"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/iconLaundry"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:contentDescription="Laundry"
                    android:src="@drawable/laundary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="Laundry"
                    android:textSize="20sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Third Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <!-- Playroom -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="8dp"
                android:gravity=""
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/iconPlayroom"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:contentDescription="Playroom"
                    android:src="@drawable/ic_game" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="Playroom"
                    android:textSize="20sp" />
            </LinearLayout>

            <!-- Bathroom -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="8dp"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/iconBathroom"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:contentDescription="Bathroom"
                    android:src="@drawable/design_sans_titre__7_" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="Bathroom"
                    android:textSize="20sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
