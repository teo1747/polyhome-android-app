<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/lovely_home_line___1_"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="8dp">

        <!-- Lights Section -->
        <EditText
            android:id="@+id/editTextText4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ems="10"
            android:inputType="text"
            android:text="Up Floor"
            android:textAlignment="center"
            android:textColor="@color/design_default_color_background"
            android:textSize="34sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/upFloorLightsIcon"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:contentDescription="Lights"
                android:src="@drawable/ic_kitchen_light" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/upFloorLightsText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Upfloor Lights"
                    android:textColor="@color/white"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/upFloorLightsOnButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:backgroundTint="@color/blue1"
                    android:text="Turn On" />

                <Button
                    android:id="@+id/upFloorLightsOffButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:backgroundTint="@color/blue1"
                    android:text="Turn Off" />
            </LinearLayout>
        </LinearLayout>

        <!-- Shutters Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/upFloorShuttersIcon"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:contentDescription="Shutters"
                android:src="@drawable/ic_shutter" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/upFloorShuttersText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Upfloor Shutters"
                    android:textColor="@color/white"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/upFloorShuttersOpenButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:backgroundTint="@color/blue1"
                    android:text="Open" />

                <Button
                    android:id="@+id/upFloorShuttersCloseButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:backgroundTint="@color/blue1"
                    android:text="Close" />

                <Button
                    android:id="@+id/upFloorShuttersStopButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:backgroundTint="@color/blue1"
                    android:text="Stop" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
